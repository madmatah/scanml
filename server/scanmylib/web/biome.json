{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "style": {
        "useConst": "error",
        "noDefaultExport": "error",
        "noDescendingSpecificity": "off",
        "useImportType": "error",
        "noEnum": "error",
        "noNamespace": "error"
      },
      "suspicious": {
        "noVar": "error",
        "noDoubleEquals": "error",
        "noMisplacedAssertion": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noDuplicateTestHooks": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noArrayIndexKey": "error"
      },
      "complexity": {
        "noExcessiveNestedTestSuites": "error"
      },
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "error"
          }
        }
      }
    },
    {
      "includes": ["i18next.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "css": {
    "linter": {
      "enabled": true
    }
  }
}
