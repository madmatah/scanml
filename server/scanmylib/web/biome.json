{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!static/vendor"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useConst": "error",
        "noDefaultExport": "error",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noVar": "error",
        "noDoubleEquals": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["static/js/locales/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "css": {
    "linter": {
      "enabled": true
    }
  }
}
