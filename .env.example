# ScanMyLib configuration: the template of production's .env, read by docker
# compose and the scripts. Do not copy it by hand: scripts/setup.sh writes
# production's .env from it (first installation, in production's checkout only)
# and adds production's identity below; in a worktree, scripts/dev-env.sh writes
# the .env of the development stack (see CLAUDE.md). Without that identity
# (COMPOSE_PROJECT_NAME), docker compose refuses to run.
#
# Format, checked by every script (scripts/lib/stack.py): KEY=VALUE lines,
# comment lines starting with "#", and blank lines, nothing else. Values only
# contain letters, digits and _ . / : @ % + , - (no spaces, quotes, "$", and no
# comment after a value).

SCANMYLIB_UID=1000
SCANMYLIB_GID=1000

# Heavy runtime data: state, Unix socket, caches, published APK, backups, logs.
DATA_DIR=/data/USER/scanmylib
# OCR sandbox venvs + models (mounted read-only by the sandbox).
SANDBOX_DIR=/data/USER/scanmylib/sandbox
# Android toolchain: SDK, Gradle caches and the app's signing key (keystore/).
ANDROID_DIR=/data/USER/scanmylib/android

# Where scanned documents and their OCR results are organized.
LIBRARY_DIR=/home/USER/Documents/ScanMyLib

# Port of the web UI / phone API, and the URL the phone uses to reach this PC.
API_PORT=8765
PUBLIC_URL=http://192.168.1.XX:8765

# Added by scripts/setup.sh to production's .env only, never to a worktree's:
#   COMPOSE_PROJECT_NAME=scanmylib  names of the containers (scanmylib-api-1...)
#   IMAGE_PREFIX=scanmylib          names of the images (scanmylib-api, -ocr)
#   SANDBOX_SETUP_DIR=<SANDBOX_DIR> where ocr-setup installs the sandbox
#                                   (read-write); the stack mounts SANDBOX_DIR
#                                   read-only
#   OCR_SERVICE=ocr                 the OCR sandbox (development: ocr-fake)
#   APP_VARIANT=release             the app fr.scanmylib (development: dev)
