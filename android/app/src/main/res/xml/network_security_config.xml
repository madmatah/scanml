<?xml version="1.0" encoding="utf-8"?>
<!--
  The PC is reached over plain HTTP at its LAN address (docs/SECURITY.md), which is only known
  at pairing time: cleartext cannot be limited to a domain, so it is allowed for the app.
  Requests carry the token only to the paired server. HTTPS only trusts the system CAs.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
