# No package's install script runs: Biome needs none, and one would run with the build's network.
FROM node:22-bookworm-slim
WORKDIR /tools
COPY server/scanmylib/web/package.json server/scanmylib/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force
USER 1000:1000
WORKDIR /web
