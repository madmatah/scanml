<?xml version="1.0" encoding="utf-8"?>
<!-- Lint reads the manifest of the variant it checks, debug, where the icon is the production one:
     the dev build type names this one through its launcherIcon placeholder (build.gradle.kts). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <background android:drawable="@color/ic_launcher_dev_background" />
    <foreground android:drawable="@drawable/ic_launcher_dev_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_dev_monochrome" />
</adaptive-icon>
