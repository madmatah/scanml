# ScanMyLib configuration (read by docker compose). Copy to .env and adapt;
# scripts/setup.sh does it for you.
SCANMYLIB_UID=1000
SCANMYLIB_GID=1000

# Heavy runtime data: sandbox venvs + models, Unix socket, caches, Android SDK.
DATA_DIR=/data/USER/scanmylib
SANDBOX_DIR=/data/USER/scanmylib/sandbox

# Where scanned documents and their OCR results are organized.
LIBRARY_DIR=/home/USER/Documents/ScanMyLib

# Port of the web UI / phone API, and the URL the phone uses to reach this PC.
API_PORT=8765
PUBLIC_URL=http://192.168.1.XX:8765
