# Private project-management repository (see CLAUDE.md)
.pm/

# The stack's configuration, never committed: written by scripts/setup.sh (production,
# primary checkout) or scripts/dev-env.sh (a worktree's development stack); see .env.example.
/.env
/.env.*.tmp

# Node (the web UI's tools: installed in their image, never in the checkout)
node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Android / Gradle build outputs and local files
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
*.apk
*.jks
*.keystore

# The rest of .claude/ is committed: only one machine's settings and its sessions' worktrees stay local
/.claude/settings.local.json
/.claude/worktrees/
