# The web UI's tools, installed by pnpm from its frozen lockfile under the guards of pnpm-workspace.yaml: no package's
# install script runs, since one would run with the build's network, and the install fails on an unreviewed one.
#
# Node is pinned by digest and pnpm's standalone build by its SHA-256, since this image never reaches production and is
# rebuilt only when they change. The stage `pnpm` alone serves the command that regenerates the lockfile (README.md >
# Development).
FROM node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS pnpm
ADD --checksum=sha256:2c58959fd5df5cb9f4e72784c08a60ffc7ee558fed9b04b22254e29112203a51 \
    https://github.com/pnpm/pnpm/releases/download/v12.17.0/pnpm-linux-x64.tar.gz /tmp/pnpm.tar.gz
RUN mkdir /opt/pnpm \
 && tar -xzf /tmp/pnpm.tar.gz -C /opt/pnpm --no-same-owner \
 && rm /tmp/pnpm.tar.gz \
 && ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

FROM pnpm AS tools
WORKDIR /tools
COPY server/scanmylib/web/package.json server/scanmylib/web/pnpm-lock.yaml server/scanmylib/web/pnpm-workspace.yaml \
    ./
RUN pnpm install --frozen-lockfile --store-dir /tmp/pnpm-store \
 && rm -rf /tmp/pnpm-store /root/.cache /root/.local
# i18next-cli parses with @swc/core, whose Linux addon ships compressed and, on its first load, writes the real addon into
# a cache it must then execute from: on the gate's read-only root, every run would need a writable, executable
# directory. Its loader runs here once instead, without network, and its addon is copied beside binding.js, the path
# binding.js tries before that self-extracting package; a second load into an empty cache must then call the binding and
# write nothing. A second copy of @swc/core, or a new version that loads otherwise, fails this step.
RUN --network=none <<'EOF'
set -eu
stores=$(find /tools/node_modules/.pnpm -mindepth 1 -maxdepth 1 -name '@swc+core@*')
if [ "$(printf '%s\n' "$stores" | grep -c .)" -ne 1 ]; then
    echo "pnpm's store must hold exactly one @swc/core, which i18next-cli and i18next-resources-for-ts share: $stores" >&2
    exit 1
fi
core=$(node -p 'path.dirname(require.resolve("@swc/core", { paths: [fs.realpathSync("/tools/node_modules/i18next-cli")] }))')
case $core in
    "$stores"/*) ;;
    *) echo "i18next-cli resolves @swc/core at $core, outside pnpm's store directory $stores" >&2; exit 1 ;;
esac
scratch=$(mktemp -d)
SWC_NATIVE_BINDING_CACHE=$scratch node -e 'require(process.argv[1])' "$core"
addons=$(find "$scratch" -type f -exec sh -c '[ "$(head -c 4 "$1" | od -An -tx1 | tr -d " \n")" = 7f454c46 ]' sh {} \; -print)
if [ "$(printf '%s\n' "$addons" | grep -c .)" -ne 1 ]; then
    echo "@swc/core's first load must write exactly one ELF addon into its cache: $addons" >&2
    exit 1
fi
install -m 0644 "$addons" "$core/swc.linux-x64-gnu.node"
rm -rf "$scratch"
empty=$(mktemp -d)
SWC_NATIVE_BINDING_CACHE=$empty node -e 'require(process.argv[1]).parseSync("const page = 1;")' "$core"
if [ -n "$(find "$empty" -mindepth 1 -print -quit)" ]; then
    echo "@swc/core still writes its cache beside the copied addon: $(find "$empty" -mindepth 1)" >&2
    exit 1
fi
rmdir "$empty"
EOF
USER 1000:1000
# The gate mounts the web UI here, so that its tools resolve /tools/node_modules by walking up the tree.
WORKDIR /tools/web
